# Runtime-generated files from packaged Unreal builds
Windows/**/Saved/Crashes/
Windows/**/Saved/Logs/
Windows/**/Saved/Config/CrashReportClient/
Windows/**/steam_appid.txt

# Development symbols are not required by connectivity testers and add
# hundreds of megabytes to every published build.
Windows/**/*.pdb

# Local archives and checksums generated for distribution
*.zip
*.7z
*.sha256

# Runtime/debug leftovers from packaged Unreal builds
Windows/Engine/Saved/
Windows/**/Saved/
Windows/Manifest_DebugFiles_Win64.txt
Windows/**/d3d12SDKLayers.dll
Windows/**/VkLayer_api_dump.*
Windows/**/VkLayer_crash_diagnostic.*
Windows/**/VkLayer_khronos_validation.*
